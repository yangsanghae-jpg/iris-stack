      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 0, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "spanNulls": true, "pointSize": 0, "showPoints": "never", "lineInterpolation": "smooth"}}},
