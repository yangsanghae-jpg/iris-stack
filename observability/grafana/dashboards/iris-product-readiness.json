    {
      "type": "table",
      "title": "구성요소",
      "gridPos": {"h": 11, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "probe_success{job=\"iris-services-blackbox\"}", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true, "format": "table"},
        {"expr": "probe_duration_seconds{job=\"iris-services-blackbox\"} * 1000", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "instant": true, "format": "table"}
      ],
      "transformations": [
        {"id": "joinByField", "options": {"byField": "instance", "mode": "outer"}},
        {"id": "organize", "options": {
          "excludeByName": {
            "Time": true, "Time 1": true, "Time 2": true,
            "job": true, "job 1": true, "job 2": true,
            "__name__": true, "__name__ 1": true, "__name__ 2": true,
            "check": true, "check 1": true, "check 2": true,
            "card 2": true, "service 2": true, "role 2": true, "surface 2": true, "kind 2": true,
            "instance": true, "surface 1": true, "kind 1": true,
            "browse_url 2": true
          },
          "indexByName": {"card 1": 0, "role 1": 1, "service 1": 2, "browse_url 1": 3, "Value #A": 4, "Value #B": 5},
          "renameByName": {"card 1": "Product", "role 1": "Role", "service 1": "Component", "browse_url 1": "Link", "Value #A": "Status", "Value #B": "Latency"}
        }},
        {"id": "sortBy", "options": {"fields": {}, "sort": [{"field": "Product", "desc": true}, {"field": "Role", "desc": false}]}}
      ],
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "minWidth": 60}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [
            {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "● DOWN", "color": "red"}, "1": {"text": "● UP", "color": "green"}}}]},
            {"id": "custom.cellOptions", "value": {"type": "color-text"}},
            {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
            {"id": "custom.width", "value": 80}, {"id": "custom.align", "value": "center"}
          ]},
          {"matcher": {"id": "byName", "options": "Latency"}, "properties": [{"id": "unit", "value": "ms"}, {"id": "custom.width", "value": 90}, {"id": "decimals", "value": 1}, {"id": "custom.align", "value": "right"}]},
          {"matcher": {"id": "byName", "options": "Role"}, "properties": [
            {"id": "mappings", "value": [{"type": "value", "options": {"body": {"text": "본체", "color": "#5794F2"}, "dependency": {"text": "의존", "color": "#8e8e93"}}}]},
            {"id": "custom.cellOptions", "value": {"type": "color-text"}},
            {"id": "custom.width", "value": 60}
          ]},
          {"matcher": {"id": "byName", "options": "Product"}, "properties": [{"id": "custom.width", "value": 120}]},
          {"matcher": {"id": "byName", "options": "Component"}, "properties": [{"id": "custom.width", "value": 120}]},
          {"matcher": {"id": "byName", "options": "Link"}, "properties": [
            {"id": "links", "value": [{"title": "↗", "url": "${__value.text}", "targetBlank": true}]},
            {"id": "custom.cellOptions", "value": {"type": "link"}},
            {"id": "custom.width", "value": 160}
          ]}
        ]
      },
      "options": {"showHeader": true, "footer": {"show": false}, "cellHeight": "sm"}
