      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "probe_success{job=\"iris-services-blackbox\"}",
          "refId": "A",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "instant": true,
          "format": "table"
        },
        {
          "expr": "probe_duration_seconds{job=\"iris-services-blackbox\"}",
          "refId": "B",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "instant": true,
          "format": "table"
        },
        {
          "expr": "probe_http_status_code{job=\"iris-services-blackbox\"}",
          "refId": "C",
          "legendFormat": "",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {"id": "joinByField", "options": {"byField": "instance", "mode": "outer"}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true,
              "job": true, "job 1": true, "job 2": true, "job 3": true,
              "__name__": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true,
              "kind 2": true, "kind 3": true,
              "layer 2": true, "layer 3": true,
              "service 2": true, "service 3": true,
              "note 2": true, "note 3": true
            },
            "renameByName": {
              "service 1": "service",
              "layer 1": "layer",
              "kind 1": "kind",
              "note 1": "note",
              "Value #A": "UP",
              "Value #B": "응답(s)",
              "Value #C": "HTTP"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "center", "displayMode": "auto"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "UP"},
            "properties": [
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}
