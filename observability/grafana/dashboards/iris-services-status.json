      "title": "서비스 상태 (UP / DOWN)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "probe_success{job=\"iris-services-blackbox\"}",
          "refId": "A",
